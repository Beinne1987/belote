<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- **نسخةُ المتجر وحدَها** (Mac App Store) — تُمرَّر وقتَ البناء:
	     xcodebuild CODE_SIGN_ENTITLEMENTS=Runner/Store.entitlements
	     لا تُنسَخ هذه المفاتيحُ إلى Release.entitlements ولا DebugProfile.entitlements:
	     `aps-environment` و`keychain-access-groups` **صلاحيّاتٌ مقيَّدة** لا تعمل إلا مع
	     ملفّ تعريفٍ (provisioning profile) من Apple، فتوقيعُها بلا ملفٍّ (ad-hoc، كحزمة
	     الـDMG المباشرة) يجعل macOS **يرفض فتحَ التطبيق** كلّيًّا. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- الإشعارات (APNs عبر FCM). مع توقيع المتجر يُحوَّل إلى production تلقائيًّا. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<!-- FirebaseInstallations يخزّن في سلسلة المفاتيح؛ الصندوقُ الرمليّ على ماك يوجب هذا. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hisabipro.belote</string>
	</array>
</dict>
</plist>
